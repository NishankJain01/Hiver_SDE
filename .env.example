# LLM Provider Configuration
# Choose one of: groq, gemini, openai, or mock (for offline zero-cost evaluation)
LLM_PROVIDER=mock

# API Keys (set the key for your chosen provider)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Model Selection
# Recommended for Groq: llama-3.3-70b-versatile or llama-3.1-8b-instant
# Recommended for Gemini: gemini-1.5-flash
# Recommended for OpenAI: gpt-4o-mini
LLM_MODEL=llama-3.3-70b-versatile
JUDGE_MODEL=llama-3.3-70b-versatile

# Pipeline Settings
CONFIDENCE_THRESHOLD=0.65
RETRIEVAL_SIMILARITY_THRESHOLD=0.55
TOP_K_RETRIEVAL=3
RANDOM_SEED=42
